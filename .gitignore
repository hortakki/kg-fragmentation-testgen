# Ignore everything by default
/*

# Keep gitignore itself
!/.gitignore

# Keep preregistration/reference files
!/preregistration.md
!/typed_elements_draft.json
!/graph_moderators.csv

# Keep selected root scripts
!/exp_core.py
!/03_run_experiment.py
!/03c_run_experiment_claude.py
!/05_evaluate.py
!/05C_evaluate_claude.py
!/05G_evaluate_gemini.py
!/06_objective_eval.py
!/06C_objective_eval_claude.py
!/07_hypothesis_analysis.py
!/08_export_typed_elements.py
!/runall.ps1
!/runall.sh

# Keep selected folders
!/analysis/
!/analysis/**
!/evaluations*/
!/evaluations*/**
!/runs*/
!/runs*/**
!/docs/
!/docs/**

# Always ignore secrets / local environments / caches
.env
**/.env
.venv/
**/.venv/
__pycache__/
**/__pycache__/
*.pyc
**/*.pyc
.cache/
cache/
logs/
nincs_cache/
nincs*/